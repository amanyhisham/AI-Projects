@model List<LunaBoutique.Models.Product>
@{
    ViewData["Title"] = "Products";
}

<section class="py-5" style="background:var(--soft-beige);min-height:80vh">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Our Collection</h2>
            <div class="title-line"></div>
        </div>

        <!-- Category Filter -->
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-5">
            <a href="/Products" class="filter-btn @(ViewBag.Category == null ? "active" : "")">All</a>
            @foreach (var cat in (List<string>)ViewBag.Categories)
            {
                <a href="/Products?category=@cat"
                   class="filter-btn @(ViewBag.Category == cat ? "active" : "")">@cat</a>
            }
        </div>

        <!-- Products Grid -->
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-6 col-md-3">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            <img src="@product.ImageUrl" alt="@product.Name" />
                            @if (product.IsNew)
                            {
                                <span class="product-badge">New</span>
                            }
                        </div>
                        <div class="product-body">
                            <div class="product-name">@product.Name</div>
                            <div class="text-muted small">@product.Category</div>
                            <div class="product-rating mt-1">★★★★★ <span style="color:#aaa">(@product.Rating)</span></div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="product-price">@product.Price.ToString("N0") EGP</div>
                                <a href="/Products/Details/@product.Id" class="btn-luna" style="padding:6px 15px;font-size:0.8rem">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .filter-btn {
        padding: 8px 20px;
        border-radius: 25px;
        border: 1.5px solid var(--nude-pink);
        color: var(--text-dark);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
    }

        .filter-btn:hover, .filter-btn.active {
            background: var(--rose-gold);
            color: white;
            border-color: var(--rose-gold);
        }
</style>