@model LunaBoutique.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<section class="py-5" style="background:var(--soft-beige)">
    <div class="container">
        <a href="/Products" style="color:var(--rose-gold);text-decoration:none">← Back to Products</a>
        <div class="row g-5 mt-2">
            <div class="col-md-6">
                <img src="@Model.ImageUrl" alt="@Model.Name"
                     style="width:100%;border-radius:20px;object-fit:cover;max-height:500px;box-shadow:0 20px 50px rgba(201,149,108,0.2)" />
            </div>
            <div class="col-md-6 d-flex flex-column justify-content-center">
                <span style="color:var(--rose-gold);font-size:0.85rem;font-weight:600;text-transform:uppercase;letter-spacing:2px">@Model.Category</span>
                <h2 style="font-size:2.2rem;font-weight:700;margin:10px 0">@Model.Name</h2>
                <div style="color:#F4A261;font-size:1.2rem">★★★★★ <span style="color:#aaa;font-size:0.9rem">(@Model.Rating)</span></div>
                <div style="font-size:2rem;font-weight:800;color:var(--rose-gold);margin:20px 0">@Model.Price.ToString("N0") EGP</div>

                <div class="d-flex gap-3 mb-4">
                    @foreach (var size in new[] { "XS", "S", "M", "L", "XL" })
                    {
                        <button class="size-btn">@size</button>
                    }
                </div>

                <button class="btn-luna px-5 py-3 mb-3">Add to Cart 🛍️</button>
                <button class="btn-luna-outline px-5 py-3">Add to Wishlist ♡</button>

                <div class="mt-4 p-3 rounded-3" style="background:white">
                    <div class="d-flex gap-3">
                        <span>🚚 Free delivery over 500 EGP</span>
                    </div>
                    <div class="d-flex gap-3 mt-2">
                        <span>↩️ Free returns within 14 days</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .size-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 1.5px solid var(--nude-pink);
        background: white;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .size-btn:hover {
            background: var(--rose-gold);
            color: white;
            border-color: var(--rose-gold);
        }
</style>