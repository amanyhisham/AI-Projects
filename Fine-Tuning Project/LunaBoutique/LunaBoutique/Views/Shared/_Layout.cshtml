<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Luna Boutique 🌙</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/luna.css" />
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg luna-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand luna-logo" href="/">🌙 Luna Boutique</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav mx-auto gap-2">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Products">Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Contact">Contact Us</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <i class="fas fa-search luna-icon"></i>
                    <i class="fas fa-heart luna-icon"></i>
                    <i class="fas fa-shopping-bag luna-icon"></i>
                </div>
            </div>
        </div>
    </nav>

    <main>@RenderBody()</main>

    <!-- Footer -->
    <footer class="luna-footer mt-5">
        <div class="container">
            <div class="row py-5">
                <div class="col-md-4 mb-4">
                    <h5 class="luna-logo mb-3">🌙 Luna Boutique</h5>
                    <p style="color:#c9b0a5;font-size:0.9rem;line-height:1.8">
                        Your destination for luxury fashion.<br>
                        Elegance is not a style, it's an attitude. ✨
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="https://www.facebook.com/amany.hisham.90/?locale=ar_AR" target="_blank" class="social-icon">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://www.instagram.com/amany.hisham.90/" target="_blank" class="social-icon">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="https://x.com/Amany_hesham1" target="_blank" class="social-icon">
                            <i class="fab fa-x-twitter"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="footer-title">Quick Links</h6>
                    <ul class="list-unstyled mt-3">
                        <li><a href="/" class="footer-link">Home</a></li>
                        <li><a href="/Products" class="footer-link">Products</a></li>
                        <li><a href="/Contact" class="footer-link">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Categories</h6>
                    <ul class="list-unstyled mt-3">
                        <li><a href="/Products?category=Dresses" class="footer-link">Dresses</a></li>
                        <li><a href="/Products?category=Tops" class="footer-link">Tops & Blouses</a></li>
                        <li><a href="/Products?category=Coats" class="footer-link">Coats</a></li>
                        <li><a href="/Products?category=Accessories" class="footer-link">Accessories</a></li>
                        <li><a href="/Products?category=Shoes" class="footer-link">Shoes</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-title">Customer Care</h6>
                    <ul class="list-unstyled mt-3">
                        <li class="footer-link">📦 Free delivery over 500 EGP</li>
                        <li class="footer-link">↩️ 14-day returns</li>
                        <li class="footer-link">💳 Cash, Card, InstaPay</li>
                        <li class="footer-link">🕐 Sun–Thu, 10am–8pm</li>
                    </ul>
                </div>
            </div>
            <hr style="border-color:#4a3030;margin:0">
            <p class="text-center py-3" style="color:#c9b0a5;font-size:0.85rem">
                © 2026 Luna Boutique. All rights reserved | Made by Amany Hisham ❤️
            </p>
        </div>
    </footer>

    @await Html.PartialAsync("_ChatWidget")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/luna-chat.js"></script>
</body>
</html>